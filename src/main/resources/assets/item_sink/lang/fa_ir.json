  "item_sink.configuration.item_sink.values.includeBundledValues.tooltip": "Keep the existing catalogue prices beneath your pricing rules.",
  "item_sink.configuration.item_sink.values.pricingRules": "Pricing Rules",
  "item_sink.configuration.item_sink.values.pricingRules.tooltip": "First match wins. Use item ids, #tags, contains:phrases, namespace:modid or wildcards, then -> tier or -> outputItem, count, ticks, FE/t.",
